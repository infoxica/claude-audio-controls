{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claude-audio-controls-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../build/web-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "local",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-audio-feedback-local",
      "database_id": "local-only",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "claude-audio-controls-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF0wxshgbCb5Mr8d"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "claude-audio-feedback-staging",
          "migrations_dir": "migrations",
          "database_id": "0a6e5f77-e10d-4390-9d36-a076ecf14b94"
        }
      ],
      "secrets": {
        "required": [
          "TURNSTILE_SECRET_KEY"
        ]
      }
    },
    "production": {
      "name": "claude-audio-controls",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF0wxxnPtuBNW-VT"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "claude-audio-feedback-production",
          "migrations_dir": "migrations",
          "database_id": "19f34dc5-f134-4b2f-a6a1-ed77f98b0a58"
        }
      ],
      "secrets": {
        "required": [
          "TURNSTILE_SECRET_KEY"
        ]
      }
    }
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  }
}
